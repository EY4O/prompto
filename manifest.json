{
  "manifest_version": 3,
  "name": "Prompto",
  "version": "0.25.3",
  "description": "Capture, organize and remix Stable Diffusion prompts, image recipes and character tags.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "scripting",
    "activeTab",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.donmai.us/*",
    "https://civitai.com/*",
    "https://civitai.green/*",
    "https://civitai.red/*",
    "https://e621.net/*",
    "https://e926.net/*",
    "https://gelbooru.com/*",
    "https://safebooru.org/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://danbooru.donmai.us/posts/*",
        "https://safebooru.donmai.us/posts/*",
        "https://gelbooru.com/index.php*",
        "https://safebooru.org/index.php*"
      ],
      "js": [
        "content/booru.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://civitai.com/*",
        "https://civitai.green/*",
        "https://civitai.red/*"
      ],
      "js": [
        "content/civitai.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Prompto",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "omnibox": {
    "keyword": "p"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Open Prompto"
    }
  }
}
